# Copie para .env e defina valores fortes em produção.
# Gere segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Banco de dados
POSTGRES_USER=user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=white_feather

# Flask / segurança
FLASK_DEBUG=0
SECRET_KEY=troque-por-um-segredo-aleatorio
JWT_SECRET_KEY=troque-por-outro-segredo-aleatorio
CORS_ORIGINS=http://localhost:5173

# Senhas do seed inicial (usuários admin/usuarioN criados na primeira subida)
ADMIN_PASSWORD=troque-esta-senha-admin
SEED_USER_PASSWORD=troque-esta-senha-usuarios
